OMNITRIX_DB=/var/lib/omnitrix/state.db
OMNITRIX_WORKSPACE_ROOT=/var/lib/omnitrix/workspaces
OMNITRIX_AUTH_USERS=/var/lib/omnitrix/auth/users.json
OMNITRIX_AUTH_SESSIONS=/var/lib/omnitrix/auth/sessions.db
OMNITRIX_CODEX_HOME=/var/lib/omnitrix/codex
OMNITRIX_CODEX_PATH=/opt/omnitrix/node_modules/.bin/codex
PATH=/opt/omnitrix/.venv/bin:/opt/omnitrix/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
OPENAI_API_KEY=
